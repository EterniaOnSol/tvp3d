# Godot/editor output
**/.godot/
**/*.uid
**/*.import

# Python/build/runtime output
**/__pycache__/
**/*.pyc
**/build/
**/bin/
**/obj/
**/Debug/
**/Release/
**/*.log

# Local server mutable state
servidor/.git/
servidor/.git.*
servidor/gamedata/
# Keep only the four reproducible account files in the repository. The rest
# of gamedata remains runtime state and stays ignored.
!servidor/gamedata/
servidor/gamedata/*
!servidor/gamedata/players/
servidor/gamedata/players/*
!servidor/gamedata/players/1/
!servidor/gamedata/players/1/1.tvpp
!servidor/gamedata/players/2/
!servidor/gamedata/players/2/2.tvpp
!servidor/gamedata/players/3/
!servidor/gamedata/players/3/3.tvpp
!servidor/gamedata/players/4/
!servidor/gamedata/players/4/4.tvpp
servidor/gamedata/players/.gitignore

# Pagina web (MyAAC). El codigo se baja con composer/npm y no va al repo;
# config.local.php e install.lock son de esta maquina.
web/myaac/vendor/
web/myaac/node_modules/
web/myaac/tools/ext/
web/myaac/config.local.php
web/myaac/install/install.lock
web/myaac/system/cache/
web/myaac/system/logs/
web/myaac/.htaccess
web/plugins-zip/*.zip

# Local recordings and extracted QA frames
worklog/video_ref*/
worklog/*.mp4
worklog/*.webm

# Local/editor noise
Thumbs.db
Desktop.ini
*.tmp
*.bak
