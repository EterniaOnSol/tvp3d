        "left_path": "/open_trade/participants_within_trade_range",
        "operator": "EQ",
        "right": {"literal": true}
      },
      {
        "assertion_id": "DISCONNECT-EACH-OFFERED-A-REAL-ITEM",
        "left_path": "/open_trade/each_participant_offered_a_real_item",
