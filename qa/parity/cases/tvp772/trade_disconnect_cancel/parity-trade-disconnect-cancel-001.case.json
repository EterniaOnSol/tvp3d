        "right": {"literal": true}
      },
      {
        "assertion_id": "DISCONNECT-BOTH-SAW-OWN-AND-COUNTERPART-OFFER",
        "left_path": "/open_trade/both_participants_saw_own_and_counterpart_offer",
        "operator": "EQ",
        "right": {"literal": true}
      },
      {
        "assertion_id": "DISCONNECT-NO-ACCEPTANCE-OR-EXPLICIT-CANCEL",
        "left_path": "/open_trade/no_acceptance_or_explicit_cancel_sent",
        "operator": "EQ",
        "right": {"literal": true}
      },
      {
        "assertion_id": "DISCONNECT-PRODUCTION-SOCKET-CLOSED-WITHOUT-GAMEPLAY",
