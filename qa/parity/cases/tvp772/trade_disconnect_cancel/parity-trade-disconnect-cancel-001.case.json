  "case_id": "PARITY-TRADE-DISCONNECT-CANCEL-001",
  "class": "LEGACY_PARITY",
  "title": "TVP 7.72 trade: disconnecting one participant closes an open trade and transfers nothing",
  "owners": ["qa"],
  "contracts": [
    {"contract": "qa", "version": "2.1.1"}
  ],
  "requirement_refs": [
    {
      "contract": "qa",
      "version": "2.1.1",
      "section": "16",
      "source_fixture_id": "PARITY-TRADE-DISCONNECT-CANCEL-001"
    }
  ],
  "preconditions": [
    "dos participantes normales con sesiones simultaneas y dentro del alcance de comercio",
    "cada uno posee un objeto real propio y distinguible",
    "las dos sesiones observan ambas ofertas antes del corte",
    "ninguno acepta ni cancela explicitamente"
  ],
  "input_fixture": {
    "logical_path": "qa/parity/fixtures/tvp772/trade_disconnect_cancel/parity-trade-disconnect-cancel-001.json"
  },
  "expected": {
