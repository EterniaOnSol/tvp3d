      },
      {
        "assertion_id": "DISCONNECT-OLD-TRADE-NOT-RESTORED",
        "left_path": "/no_transfer/disconnected_participant_old_trade_not_restored",
        "operator": "EQ",
        "right": {"literal": true}
      }
    ]
